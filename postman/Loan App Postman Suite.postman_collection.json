		{
			"name": "Auth - signInWithPassword (Get ID Token)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
							"pm.test(\"Contains idToken and refreshToken\", function () {",
							"    var json = pm.response.json();",
							"    pm.expect(json).to.have.property('idToken');",
							"    pm.expect(json).to.have.property('refreshToken');",
							"    // Save tokens into the environment for subsequent requests",
							"    pm.environment.set('userToken', json.idToken);",
							"    pm.environment.set('refreshToken', json.refreshToken);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{ \"email\": \"{{testUserEmail}}\", \"password\": \"{{testUserPassword}}\", \"returnSecureToken\": true }"
				},
				"url": {
					"raw": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{apiKey}}",
					"protocol": "https",
					"host": [
						"identitytoolkit",
						"googleapis",
						"com"
					],
					"path": [
						"v1",
						"accounts:signInWithPassword"
					],
					"query": [
						{
							"key": "key",
							"value": "{{apiKey}}"
						}
					]
				}
			},
			"response": []
		}
